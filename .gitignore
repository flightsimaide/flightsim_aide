# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing material: never commit
android/key.properties
**/*.jks
**/*.keystore
*.p12
*.mobileprovision

# Personal scratch folder (same rule as the original project)
Documentation/temp/

# Plugin build output
plugin/build/
plugin/build-xp/
plugin/build-msfs/

# External downloads (SDKs and other third-party files we must not redistribute).
# The folder stays in the repository, empty; see BUILDING.md for what goes in it.
/external/*
!/external/.gitkeep

# Local example checklists: the folder and its README are tracked, the checklists are not.
/Documentation/Examples/*
!/Documentation/Examples/README.md

# Local dataref lists read from the author's sim (names and values belong to
# Laminar Research, add-on authors and others): the folder and its README are
# tracked, the lists are not. See Documentation/Reference/datarefs/README.md.
/Documentation/Reference/datarefs/*
!/Documentation/Reference/datarefs/README.md

# Legacy Flutter files
.packages
.flutter-plugins
tools/platform/win/msfs_setup/work/
tools/platform/win/msfs_setup/out/

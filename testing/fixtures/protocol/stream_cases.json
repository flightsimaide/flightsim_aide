    {
      "name": "array range is one list of values",
      "steps": [
        {
          "send": {
            "op": "subscribe",
            "id": 20,
            "name": "sim/cockpit2/engine/actuators/throttle_ratio[0..2]",
            "hz": 5
          }
        },
        {
          "expect": {
            "op": "subscribed",
            "id": 20
          },
          "withinMs": 1500
        },
        {
          "expect": {
            "op": "values",
            "v": {
              "20": [
                0.25,
                0.5,
                0.75
              ]
            }
          },
          "withinMs": 1500
        }
      ]
    },
    {
      "name": "array range cut short where the array ends",
      "steps": [
        {
          "send": {
            "op": "subscribe",
            "id": 21,
            "name": "sim/cockpit2/engine/actuators/throttle_ratio[2..9]",
            "hz": 5
          }
        },
        {
          "expect": {
            "op": "subscribed",
            "id": 21
          },
          "withinMs": 1500
        },
        {
          "expect": {
            "op": "values",
            "v": {
              "21": [
                0.75,
                1
              ]
            }
          },
          "withinMs": 1500
        }
      ]
    },
    {
      "name": "array range past the end is an empty list",
